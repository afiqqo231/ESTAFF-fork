@{
	var fullName = ViewBag.FullName as string ?? User.Identity.Name;
	var initials = string.Concat(fullName.Split(' ')
		.Where(w => w.Length > 0)
		.Select(w => w[0].ToString().ToUpper()));

	var currentAction = ViewContext.RouteData.Values["action"].ToString();
	var currentController = ViewContext.RouteData.Values["controller"].ToString();
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewBag.Title - ESTAFF</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
	<link href="~/Content/css/layout.css" rel="stylesheet" />
	<link href="~/Content/css/shared.css" rel="stylesheet" />
	<link href="~/Content/css/staff.css" rel="stylesheet" />
	@RenderSection("PageStyles", required: false)
</head>
<body>

	// Sidebar
	<div class="sidebar">
		<div class="sidebar-brand">
			<i class="fas fa-tasks"></i>
			<h5>ESTAFF</h5>
			<p>Staff Portal</p>
		</div>

		<nav class="sidebar-nav">
			<p class="nav-section-label">Main</p>
			<a href="@Url.Action("Index", "Staff")" 
			   class="nav-link @(currentController == "Staff" && currentAction == "Index" ? "active" : "")">
				<i class="fas fa-tachometer-alt"></i> Dashboard
			</a>

			<p class="nav-section-label">Tasks</p>
			<a href="@Url.Action("MyTasks", "Staff")"
				class="nav-link @(currentAction == "MyTasks" ? "active" : "")">
				<i class="fas fa-list-check"></i> My Tasks
			</a>
			<a href="@Url.Action("CreateTask", "Staff")"
				class="nav-link @(currentAction == "CreateTask" ? "active" : "")">
				<i class="fas fa-plus-circle"></i> Create Task
			</a>
			<a href="@Url.Action("DailyView", "Staff")"
				class="nav-link @(currentAction == "DailyView" ? "active" : "")">
				<i class="fas fa-calendar-day"></i> Daily View
			</a>
			<a href="@Url.Action("WeeklyView", "Staff")"
				class="nav-link @(currentAction == "WeeklyView" ? "active" : "")">
				<i class="fas fa-calendar-week"></i> Weekly View
			</a>

			<p class="nav-section-label">Reports</p>
			<a href="@Url.Action("MyReports", "Dashboard")"
				class="nav-link @(currentAction == "MyReports" ? "active" : "")">
				<i class="fas fa-file-alt"></i> My Reports
			</a>
			<a href="@Url.Action("GenerateReport", "Staff")"
				class="nav-link @(currentAction == "GenerateReport" ? "active" : "")">
				<i class="fas fa-plus-circle"></i> Generate Report
			</a>
		</nav>

		<div class="sidebar-footer">
			<div class="sidebar-user">
				<div class="sidebar-avatar">@initials</div>
				<div class="sidebar-user-info">
					<p>@fullName</p>
					<span><i class="fas fa-circle text-success" style="font-size: 0.6rem"></i>Staff</span>
				</div>
			</div>
			@using (Html.BeginForm("Logout", "Account", FormMethod.Post))
			{
				@Html.AntiForgeryToken()
				<button type="submit" class="btn btn-logout">
					<i class="fas fa-sign-out-alt me-2"></i> Logout
				</button>
			}
		</div>
	</div>

	// Main content
	<div class="main-content">
		<div class="topbar">
			<div class="topbar-title">
				<h4>@ViewBag.PageTitle</h4>
				<p>@ViewBag.PageSubtitle</p>
			</div>
			<div class="d-flex align-items-center gap-3">
				<span class="badge-employee">
					<i class="fas fa-calendar me-1"></i> @DateTime.Now.ToString("MMMM dd, yyyy")
				</span>
			</div>
		</div>

		<div class="page-content">
			@if (TempData["SuccessMessage"] != null)
			{
				<div class="alert alert-success alert-dismissible fade show" role="alert">
					<i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
			}

			@if (TempData["ErrorMessage"] != null)
			{
				<div class="alert alert-danger alert-dismissible fade show" role="alert">
					<i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
			}

			@RenderBody()
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("PageScripts", required: false)
</body>
</html>