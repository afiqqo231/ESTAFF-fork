@{
	var fullName = ViewBag.FullName as string ?? User.Identity.Name;
	var initials = string.Concat(fullName.Split(' ')
	    .Where(w => w.Length > 0)
		.Select(w => w[0].ToString().ToUpper()));	
	var currentAction = ViewContext.RouteData.Values["action"].ToString();
	var currentController = ViewContext.RouteData.Values["controller"].ToString();
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewBag.Title - ESTAFF</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/css/layout.css" rel="stylesheet" />
    <link href="~/Content/css/shared.css" rel="stylesheet" />
    <link href="~/Content/css/manager.css" rel="stylesheet" />
    @RenderSection("PageStyles", required: false)
</head>
<body>

	// Sidebar
	<div class="sidebar">
		<div class="sidebar-brand">
			<i class="fas fa-user-tie"></i>
			<h5>ESTAFF</h5>
			<p>Manager Portal</p>
	</div>

	<nav class="sidebar-nav">
		<p class="nav-section-table">Main</p>
		<a href="@Url.Action("Index", "Manager")" 
		   class="nav-link @(currentController == "Manager" && currentAction == "Index" ? "active" : "")">
			<i class="fas fa-tachometer-alt"></i> Dashboard
		</a>

		<p class="nav-section-table">Team</p>
		<a href="@Url.Action("Staff", "Manager")"
			class="nav-link @(currentAction == "Staff" ? "active" : "")">
			<i class="fas fa-user"></i> My Employee
		</a>
		<a href="@Url.Action("CreateStaff", "Manager")"
			class="nav-link @(currentAction == "CreateStaff" ? "active" : "")">
			<i class="fas fa-user-plus"></i> Add New Employee
		</a>

		<p class="nav-section-label">Tasks</p>
		<a href="@Url.Action("Task", "Manager")"
			class="nav-link @(currentAction == "Task" ? "active" : "")">
			<i class="fas fa-list-check"></i> All Tasks
		</a>
		<a href="@Url.Action("AssignTask", "Manager")"
			class="nav-link @(currentAction == "AssignTask" ? "active" : "")">
			<i class="fas fa-plus-circle"></i> Assign Task
		</a>
		<a href="@Url.Action("TaskHistory", "Manager")"
			class="nav-link @(currentAction == "TaskHistory" ? "active" : "")">
			<i class="fas fa-history"></i> Task History
		</a>
		
		<p class="nav-section-label">Reports</p>
		<a href="@Url.Action("PendingReport", "Manager")"
			class="nav-link @(currentAction == "PendingReport" ? "active" : "")">
			<i class="fas fa-file-alt"></i> Pending Approvals
			@if (ViewBag.PendingReportCount != null && ViewBag.PendingReportCount > 0)
			{ 
				<span class="badge bg-danger">@ViewBag.PendingReportsCount</span>
			}
		</a>
		<a href="@Url.Action("ApprovedReport", "Manager")"
			class="nav-link @(currentAction == "ApprovedReport" ? "active" : "")">
			<i class="fas fa-file-check"></i> Approved Reports
		</a>
	</nav>

	<div class="sidebar-footer">
		<div class="sidebar-user">
			<div class="sidebar-avatar">@initials</div>
			<div class="sidebar-user-info">
				<p>@fullName</p>
				<span><i class="fas fa-circle text-success" style="font-size:0.6rem;"></i> Manager</span>
			</div>
		</div>
		@using (Html.BeginForm("Logout", "Account", FormMethod.Post))
		{
			@Html.AntiForgeryToken()
			<button type="submit" class="btn btn-logout">
				<i class="fas fa-sign-out-alt me-2"></i> Logout
			</button>
		}
		</div>
	</div>

	// Main Content
	<div class="main-content">
		<div class="topbar">
			<div class="topbar-title">
				<h4>@ViewBag.PageTitle</h4>
				<p>@ViewBag.PageSubtitle</p>
			</div>
			<div class="d-flex align-items-center gap-3">
				<span class="badge-manager">
					<i class="fas fa-user-tie me-2"></i> Manager
				</span>
				<span class="text-muted small">
					<i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dd MM yyyy")
				</span>
			</div>
		</div>

		<div class="page-content">
			@if (TempData["SuccessMessage"] != null)
			{
				<div class="alert alert-success alert-dismissible fade show" role="alert">
					<i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
			}
			@if (TempData["ErrorMessage"] != null)
			{
				<div class="alert alert-danger alert-dismissible fade show" role="alert">
					<i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
			}

			@RenderBody()
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("PageScripts", required: false)
</body>
</html>
