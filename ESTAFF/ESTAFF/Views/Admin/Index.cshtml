@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Stat Cards -->
<div class="stats-grid">

    <div class="stat-card blue">
        <i class= "fas fa-users stat-icon"></i>
        <div class="stat-value">@ViewBag.TotalEmployees</div>
        <div class="stat-label">Total Employees</div>
        <div class="stat-meta">
            <a href="@Url.Action("Employees", "Admin")">Manage Team</a>
        </div>
    </div>

    <div class="stat-card green">
        <i class="fas fa-list-check stat-icon"></i>
        <div class="stat-value">@ViewBag.ActiveTasks</div>
        <div class="stat-label">Active Tasks</div>
        <div class="stat-meta">
            <a href="@Url.Action("Tasks", "Admin")">View Tasks</a>
        </div>
    </div>

    <div class="stat-card red">
        <i class="fas fa-exclamation-circle stat-icon"></i>
        <div class="stat-value">@ViewBag.OverdueTasks</div>
        <div class="stat-label">Overdue Tasks</div>
        <div class="stat-meta">Needs immediate attention</div>
    </div>

    <div class="stat-card purple">
        <i class="fas fa-file-alt stat-icon"></i>
        <div class="stat-value">@ViewBag.PendingReports</div>
        <div class="stat-label">Pending Reports</div>
        <div class="stat-meta">
            <a href="@Url.Action("PendingReports", "Admin")">Review Now</a>
        </div>
    </div>

    <div class="stat-card orange">
        <i class="fas fa-chart-pie stat-icon"></i>
        <div class="stat-value">@ViewBag.OnTimeRate%</div>
        <div class="stat-label">Team completion average</div>
</div>

<!-- Middle Row -->
<div class="row g-4 mb-4">

    <!-- Recent Tasks Card -->
    <div class="col-lg-8">
        <div class="data-card">
            <div class="data-card-header">
                <h6>
                    <i class="fas fa-clock me-2 text-primary"></i>Recent Tasks
                </h6>
                <a href="@Url.Action("Tasks", "Admin")" 
                    class="btn-primary-custom" style="font-size:0.78rem; padding: 0.35rem 0.85rem;">
                    View All
                </a>
            </div>
            <div class="data-card-body">
                @if (ViewBag.RecentTasks != null &&
                    ((IEnumerable<ESTAFF.Models.Data.TaskItem>)ViewBag.RecentTasks).Any())
                {
                    foreach (var task in (IEnumerable<ESTAFF.Models.Data.TaskItem>)ViewBag.RecentTasks)
                    {
                        var dotClass = task.Status.ToString().ToLower()
                            .Replace("inprogress","inprogress");

                        <div class="task-item">
                            <div class="task-dot @dotClass"></div>
                            <div class="task-info">
                                <h6>@task.Title</h6>
                                <p>
                                    Assigned to
                                    <strong>@task.AssignedToUser?.FullName</strong>
                                    &nbsp;&nbsp;
                                    Due @task.DueDate.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                            <span class="status-badge status-@dotClass">
                                @task.Status
                            </span>        
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <h5>No tasks yet</h5>
                        <p>Assign your team a task to get started.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Task Breakdown -->
    <div class="col-lg-4">
        <div class="data-card h-100">
            <div class="data-card-header">
                <h6>
                    <i class="fas fa-chart-donut me-2 text-primary"></i>
                    Task Breakdown
                </h6>
            </div>
            <div class="data-card-body">
                <div class="breakdown-grid">
                    <div class="breakdown-item pending">
                        <div class="breakdown-value">@ViewBag.PendingCount</div>
                        <div class="breakdown-label">Pending</div>
                    </div>
                    <div class="breakdown-item inprogress">
                        <div class="breakdown-value">@ViewBag.InProgressCount</div>
                        <div class="breakdown-label">In Progress</div>
                    </div>
                    <div class="breakdown-item complete">
                        <div class="breakdown-value">@ViewBag.CompleteCount</div>
                        <div class="breakdown-label">Completed</div>
                    </div>
                    <div class="breakdown-item overdue">
                        <div class="breakdown-value">@ViewBag.OverdueCount</div>
                        <div class="breakdown-label">Overdue</div>
                    </div>
                </div>
                
                <hr class="my-3" />

                <div class="text-center">
                    <p class="text-muted small mb-1">Total Tasks</p>
                    <h3 class="fw-700 text-primary mb-0">@ViewBag.TotalTasks</h3>
                </div>
            </div>
        </div>
    </div>

</div>

<! -- Quick Action -- >
<div class="data-card">
    <div class="data-card-header">
        <h6>
            <i class="fas fa-bolt me-2 text-warning"></i>Quick Actions
        </h6>
    </div>
    <div class="data-card-body">
        <div class="quick-actions-grid">
            <a href="@Url.Action("CreateStaff", "Admin")"
                class="quick-action-btn">
                <i class="fas fa-user-plus"></i>
                <span>Add Employee</span>
            </a>
            <a href="@Url.Action("AssignTask", "Admin")"
                class="quick-action-btn">
                <i class="fas fa-plus-circle"></i>
                <span>Review Reports</span>
            </a>
            <a href="@Url.Action("PendingReports", "Admin")"
               class="quick-action-btn">
                <i class="fas fa-file-check"></i>
                <span>Review Reports</span>
            </a>
            <a href="@Url.Action("TaskHistory", "Admin")"
                class="quick-action-btn">
                <i class="fas fa-history"></i>
                <span>Task History</span>
            </a>
            <a href="@Url.Action("Employees", "Admin")"
               class="quick-action-btn">
                <i class="fas fa-users"></i>
                <span>View Team</span>
            </a>
            <a href="@Url.Action("ApprovedReports", "Admin")"
               class="quick-action-btn">
                <i class="fas fa-check-circle"></i>
                <span>Approved Reports</span>
            </a>
        </div>
    </div>
</div>
