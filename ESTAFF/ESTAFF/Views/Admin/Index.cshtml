@{
	ViewBag.Title = "Dashboard";
    ViewBag.PageTitle = "Dashboard";
    ViewBag.PageSubtitle = "Overview of your team and tasks";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- STAT CARDS -->
<div class="dashboard-grid">

	<!-- Total Employees -->
	<div class="dashboard-stat">
		<div class="stat-icon">
			<i class="fas fa-users"></i>
		</div>
		<div class="stat-number">@ViewBag.TotalStaffs</div>
		<div class="stat-title">Total EHS Team</div>
		<div class="stat-meta">
			<a href="@Url.Action("Staffs", "Manager")" class="text-decoration-none">
				Manage team
			</a>
		</div>
	</div>

	<!-- Active Tasks -->
	<div class="dashboard-stat green">
        <div class="stat-icon">
            <i class="fas fa-tasks"></i>
        </div>
        <div class="stat-number">@ViewBag.TotalActiveTasks</div>
        <div class="stat-title">Active Tasks</div>
        <div class="stat-meta">
            <a href="@Url.Action("Tasks", "Manager")" class="text-decoration-none">
                View all 
            </a>
        </div>
    </div>

	<!-- Overdue Tasks -->
	<div class="dashboard-stat red">
        <div class="stat-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <div class="stat-number">@ViewBag.OverdueTasks</div>
        <div class="stat-title">Overdue Tasks</div>
        <div class="stat-meta">
            Needs attention
        </div>
    </div>

	<!-- Pending Approvals -->
	<div class="dashboard-stat purple">
        <div class="stat-icon">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <div class="stat-number">@ViewBag.PendingReports</div>
        <div class="stat-title">Pending Reports</div>
        <div class="stat-meta">
            <a href="@Url.Action("PendingReports", "Manager")" class="text-decoration-none">
                Review 
            </a>
        </div>
    </div>

	<!-- On time Rate -->
	<div class="dashboard-stat blue">
        <div class="stat-icon">
            <i class="fas fa-chart-pie"></i>
        </div>
        <div class="stat-number">@ViewBag.OnTimeCompletionRate%</div>
        <div class="stat-title">On-Time Completion</div>
        <div class="stat-meta">
            Team average
        </div>
    </div>

</div>

<div class="row g-4">

	<!-- Recent Tasks -->
	<div class="col-12">
        <div class="section-card">
            <div class="section-header">
                <h6>
                    Recent Tasks
                </h6>
                <a href="@Url.Action("Tasks", "Manager")" class="btn btn-sm btn-primary-custom">
                    View All 
                </a>
            </div>
            <div class="section-body">
				@if (ViewBag.RecentTasks != null && ViewBag.RecentTasks.Count > 0)
                {
                    foreach (var task in ViewBag.RecentTasks)
                    {
                        var employee = task.AssignedToUser;
                        var statusClass = task.Status.ToString().ToLower();
                        <div class="task-item">
                            <div class="task-status @statusClass"></div>
                            <div class="task-content flex-grow-1">
                                <h6>@task.Title</h6>
                                <p>
                                    Assigned to <strong>@employee.FullName</strong>
                                    • Due @task.DueDate.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                            <div>
								<span class="status-badge status-@statusClass">
                                    @task.Status
                                </span>
                            </div>
                        </div>
                    }
                }
                else
				{
                    <div class="empty-message">
                        <i class="fas fa-inbox"></i>
                        <p>No tasks assigned yet</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<!-- Quick Actions -->
<div class="section-card">
    <div class="section-header">
        <h6>
            Quick Actions
        </h6>
    </div>
    <div class="section-body">
        <div class="row g-2">
            <div class="col-sm-6 col-md-3">
                <a href="@Url.Action("CreateStaff", "Manager")" class="btn btn-primary-custom w-100">
                    <i class="fas fa-user-plus me-2"></i>Add Employee
                </a>
            </div>
            <div class="col-sm-6 col-md-3">
                <a href="@Url.Action("AssignTask", "Manager")" class="btn btn-primary-custom w-100">
                    <i class="fas fa-plus-circle me-2"></i>Assign Task
                </a>
            </div>
			<div class="col-sm-6 col-md-3">
                <a href="@Url.Action("PendingReports", "Manager")" class="btn btn-primary-custom w-100">
                    <i class="fas fa-file-check me-2"></i>Review Reports
                </a>
            </div>
            <div class="col-sm-6 col-md-3">
                <a href="@Url.Action("TaskHistory", "Manager")" class="btn btn-primary-custom w-100">
                    <i class="fas fa-history me-2"></i>Task History
                </a>
            </div>
        </div>
    </div>
</div>