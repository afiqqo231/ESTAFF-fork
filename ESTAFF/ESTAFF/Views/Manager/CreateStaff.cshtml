@model ESTAFF.models.ViewModels.CreateStaffViewModel
@{
	ViewBag.Title = "Create Staff Account";
	Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="row justify-content-center">
	<div class="col-md-7">
		<div class="data-card">
			<div class="data-card-header">
				<h6><i class="fas fa-user-plus me-2"></i>New EHS team member</h6>
			</div>
			<div class="card-body p-4">
				@using (Html.BeginForm("CreateStaff", "Manager", FormMethod.Post,))
				{
					@Html.AntiForgeryToken()
					@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

					<div class="row g-3">

						<div class="col-md-6">
							@Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-semibold" })
							<div class="input-group">
								<span class="input-group-text">
									<i class="fas fa-user text-muted"></i>
								</span>
								@Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Full Name" })
							</div>
							@Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
						</div>

						<div class="col-md-6">
							@Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
							<div class="input-group">
								<span class="input-group-text">
									<i class="fas fa-envelope text-muted"></i>
								</span>
								@Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email Address" })
							</div>
							@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
						</div>
						
						<div class="col-md-6">
							@HtmlLabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
							<div class="input-group">
								<span class="input-group-text">
									<i class="fas fa-lock text-muted"></i>
								</span>
								@Html.PasswordFor(m => m.Password, "", new { @class = "form-control", placeholder = "Temporary Password" })
							</div>
							@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
							<small class="text-muted">Staff will use this to log in.</small>
						</div>

						<div class="col-md-6">
							@Html.LabelFor(m => m.Department, new { @class = "form-label fw-semibold" })
							<div class="input-group">
								<span class="input-group-text">
									<i class="fas fa-building text-muted"></i>
								</span>
								@Html.DropDownListFor(m => m.Department, new { @class = "form-control", placeholder = "e.g. SHO" })
							</div>
							@Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger small" })
						</div>

						<div class="col-md-6">
							@Html.LabelFor(m => m.HireDate, new { @class = "form-label fw-semibold" })
							<div class="input-group">
								<span class="input-group-text">
									<i class="fas fa-calendar text-muted"></i>
								</span>
								@Html.TextBoxFor(m => m.HireDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
							</div>
							@Html.ValidationMessageFor(m => m.HireDate, "", new { @class = "text-danger small"})
						</div>

						<div class="col-md-6">
							@Html.LabelFor(m => m.Role, new { @class = "form-label fw-semibold" })
							<div class="role-select-group">
								<div class="role-option" onlick="selectRole('Staff', this)">
									<i class="fas fa-user text-muted"></i>
									<span>Staff</span>
								</div>
								<div class="role-option" onclick="selectRole('Manager', this)">
									<i class="fas fa-user-tie text-primary"></i>
									<span>Manager</span>
								</div>
							</div>
							@Html.HiddenFor(m => m.Role, new { id = "roleInput" })
							@Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small" })
						</div>
					</div>

					<hr class="my-4" />

					<div class="d-flex gap-2 justify-content-end">
						<a href="@Url.Action("Staff", "Manager")" class="btn btn-outline-secondary">
							<i class="fas fa-time me-1"></i>Cancel
						</a>
						<button type="submit" class="btn btn-primary">
							<i class="fas fa-user-plus me-1"></i>Create Account
						</button>
					</div>
				}
			</div>
		</div>
	</div>
</div>

@section PageScripts {
	<script>
		function selectRole(role, element) {
			document.querySelectorAll('.role-option').forEach(c => c.classList.remove('selected'));
			element.classList.add('selected');
			document.getElementById('roleInput').value = role;
		}
	</script>
}